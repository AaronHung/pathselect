__pycache__/
*.pyc
.pytest_cache/
outputs/_status/

# 大型產物 —— 針對「未來新增的」。已在歷史裡的 outputs/exp2/seqft/ckpt/ 維持追蹤
# （DR 卡的 evidence 引用 commit hash，改寫歷史會破壞可追溯性）。
ckpt/
*_probe_features.npz
outputs/**/_probe_features.npz
.DS_Store

# LaTeX 中間產物與編譯出的 PDF（paper/ 只收原始檔；PDF 由 Overleaf／本機重編，不進 git）
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.blg
paper/*.out
paper/*.bbl
paper/*.synctex.gz
*.log
*.bbl
*.blg
*.out
*.synctex.gz
# 圖檔例外：paper/figures/*.pdf 是向量圖原檔，必須追蹤
!paper/figures/*.pdf
# 實驗 log 例外：logs/ 與 outputs/ 下的 run log 是 DR 卡引用的證據，必須追蹤
!logs/**/*.log
!outputs/**/*.log
